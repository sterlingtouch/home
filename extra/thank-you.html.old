<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quote Request Sent | Sterling Touch</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <main class="section-pad section-dark" style="min-height: 100vh; display: grid; place-items: center;">
      <div class="container narrow" style="text-align: center;">
        <p class="eyebrow">Request received</p>
        <h1>Send your bathroom photos next.</h1>
        <p>
          Text clear photos of the tub, shower, glass, grout, and problem areas to
          <a href="sms:+10000000000" style="color: var(--accent); font-weight: 900;">(000) 000-0000</a>.
        </p>
        <p><a class="btn btn-primary" href="index.html">Back to home</a></p>
      </div>
    </main>
  </body>
</html>
